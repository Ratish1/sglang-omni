{
  "repo_root": ".",
  "server": {
    "argv": [
      "sgl-omni",
      "serve",
      "--model-path",
      "FunAudioLLM/Fun-ASR-Nano-2512-hf",
      "--host",
      "127.0.0.1",
      "--port",
      "8000",
      "--stages.asr.factory_args.pre_lm_cache_max_entries=0",
      "--stages.asr.factory_args.pre_lm_cache_size_bytes=0"
    ],
    "env": {
      "OMP_NUM_THREADS": "1",
      "MKL_NUM_THREADS": "1",
      "OPENBLAS_NUM_THREADS": "1",
      "SGLANG_OMNI_EVENT_DEFER_WRITES": "1",
      "SGLANG_OMNI_EVENT_QUEUE_CAPACITY": "131072",
      "SGLANG_OMNI_EVENT_FINALIZE_TIMEOUT_S": "180"
    },
    "ready_url": "http://127.0.0.1:8000/health",
    "ready_timeout_s": 900,
    "stop_timeout_s": 60
  },
  "harness_args": [
    "--mode",
    "events",
    "--host",
    "127.0.0.1",
    "--port",
    "8000",
    "--stage",
    "asr",
    "--model-revision",
    "REPLACE_WITH_IMMUTABLE_HF_COMMIT_SHA",
    "--workload-contract",
    "direct-steady-miss",
    "--concurrency",
    "64",
    "--max-samples",
    "1088",
    "--profile-samples",
    "256",
    "--collectors",
    "psi,cgroup-psi,thread-snapshot,gpu-dmon",
    "--gpu-index",
    "0"
  ],
  "conditions": [
    {
      "name": "quiet",
      "harness_args": [
        "--max-cpu-psi-some-fraction",
        "0.02"
      ]
    },
    {
      "name": "unbound-cpu64",
      "interferer_argv": [
        "python",
        "-m",
        "benchmarks.profiling.cpu_interferer",
        "--workers",
        "64"
      ],
      "interferer_settle_s": 5
    }
  ],
  "protocol": {
    "restarts_per_condition": 5,
    "random_seed": 20260805,
    "continue_on_failure": false
  }
}
