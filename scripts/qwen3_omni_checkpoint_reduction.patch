 constexpr static int FINALIZE_THREADS_PER_BLOCK = 256;

+__device__ __forceinline__ int nextExpertRankInOrder(int const* selected_experts,
+                                                   int64_t experts_per_token,
+                                                   int& previous_expert_id, int& previous_rank) {
+  int next_expert_id = std::numeric_limits<int>::max();
+  int next_rank = std::numeric_limits<int>::max();
+  for (int rank = 0; rank < experts_per_token; ++rank) {
+    int const expert_id = selected_experts[rank];
+    bool const follows_previous = expert_id > previous_expert_id ||
+                                  (expert_id == previous_expert_id && rank > previous_rank);
+    bool const precedes_next =
+        expert_id < next_expert_id || (expert_id == next_expert_id && rank < next_rank);
+    if (follows_previous && precedes_next) {
+      next_expert_id = expert_id;
+      next_rank = rank;
+    }
+  }
+  assert(next_rank < experts_per_token);
+  previous_expert_id = next_expert_id;
+  previous_rank = next_rank;
+  return next_rank;
+}
